# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL (local Docker Compose defaults)
POSTGRES_DB=trial_matcher
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/trial_matcher

# Redis and background jobs
REDIS_URL=redis://redis:6379/0

# ClinicalTrials.gov
CLINICAL_TRIALS_API_BASE_URL=https://clinicaltrials.gov/api/v2

# Models
# Use explicit, versioned model identifiers when these integrations are implemented.
LLM_PROVIDER=local
LLM_MODEL=replace-with-an-explicit-version
EMBEDDING_MODEL=replace-with-an-explicit-version
LLM_API_KEY=

# Data safety
# Keep false for development and public demos. The application must reject
# imports that lack the project's synthetic-data marker while this is false.
ALLOW_REAL_PATIENT_DATA=false

# Production-like environments are blocked unless this is explicitly enabled.
# This override does not permit real patient data or clinical use.
ALLOW_PRODUCTION_LIKE_ENVIRONMENT=false
